{
  "name": "records-manager-erp-server",
  "version": "1.0.0",
  "description": "Stateless Express REST API for Perfume ERP + POS",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "npx prisma generate",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate deploy",
    "prisma:seed": "node prisma/seed.js",
    "bootstrap:admin": "node scripts/bootstrap-admin.js",
    "db:backup": "node scripts/backup-database.js",
    "db:clean": "node scripts/clean-database.js",
    "test": "node --test ../tests/unit/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
