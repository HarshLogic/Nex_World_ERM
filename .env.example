# ==============================================================================
# ENVIRONMENT CONFIGURATION - PERFUME ERP + POS + INVENTORY
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=5000

# Backend Instances for Local / Docker
API1_PORT=5001
API2_PORT=5002

# Next.js Client
NEXT_PUBLIC_API_URL=http://localhost:5000/api
CLIENT_PORT=3000

# PostgreSQL Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=erp_user
DB_PASSWORD=YOUR_STRONG_DB_PASSWORD
DB_NAME=erp_records_db
DATABASE_URL=postgresql://erp_user:YOUR_STRONG_DB_PASSWORD@localhost:5432/erp_records_db?schema=public

# Initial Administrator Credentials (Configured securely on backend only)
ADMIN_NAME=Administrator
ADMIN_EMAIL=client-admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_UNIQUE_PASSWORD
ADMIN_ROLE=ADMIN

# JWT Secrets & Security (Minimum 32 random characters in production)
JWT_SECRET=super_secret_jwt_signing_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=erp_token
COOKIE_SECURE=false

# Default Currency & Settings
DEFAULT_CURRENCY=AED
DEFAULT_TAX_RATE=5.00
PRICES_INCLUDE_TAX=true
