# ==============================================================================
# ENVIRONMENT CONFIGURATION - RECORDS MANAGER ERP + POS + INVENTORY
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=5000

# Backend Instances for Local / Docker
API1_PORT=5001
API2_PORT=5002

# Next.js Client
NEXT_PUBLIC_API_URL=http://localhost:5000/api
CLIENT_PORT=3000

# PostgreSQL Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=erp_user
DB_PASSWORD=erp_secure_password_123
DB_NAME=erp_records_db
DATABASE_URL=postgresql://erp_user:erp_secure_password_123@localhost:5432/erp_records_db?schema=public

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Security
JWT_SECRET=super_secret_jwt_signing_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=erp_token
COOKIE_SECURE=false

# Default Currency & Settings
DEFAULT_CURRENCY=AED
DEFAULT_TAX_RATE=5.00
PRICES_INCLUDE_TAX=true

